using System;
using System.Collections.Generic;
using System.Drawing;
using System.Linq;
using System.Windows.Forms;

namespace BodyLanguageQuizApp
{
    public partial class Form1 : Form
    {
        List<Question> questions = new List<Question>();

        int currentQuestion = 0;
        int score = 0;

        public Form1()
        {
            InitializeComponent();
            LoadQuestions();
            ShowQuestion();
        }

        Label lblQuestion = new Label();
        RadioButton option1 = new RadioButton();
        RadioButton option2 = new RadioButton();
        RadioButton option3 = new RadioButton();
        RadioButton option4 = new RadioButton();

        Button btnNext = new Button();

        private void InitializeComponent()
        {
            this.Text = "Body Language Quiz";
            this.Size = new Size(800, 600);
            this.BackColor = Color.White;

            lblQuestion.Location = new Point(50, 40);
            lblQuestion.Size = new Size(700, 80);
            lblQuestion.Font = new Font("Arial", 16, FontStyle.Bold);

            option1.Location = new Point(70, 150);
            option1.Size = new Size(600, 30);

            option2.Location = new Point(70, 200);
            option2.Size = new Size(600, 30);

            option3.Location = new Point(70, 250);
            option3.Size = new Size(600, 30);

            option4.Location = new Point(70, 300);
            option4.Size = new Size(600, 30);

            btnNext.Text = "Next";
            btnNext.Location = new Point(300, 400);
            btnNext.Size = new Size(150, 50);
            btnNext.BackColor = Color.RoyalBlue;
            btnNext.ForeColor = Color.White;
            btnNext.Font = new Font("Arial", 12, FontStyle.Bold);

            btnNext.Click += BtnNext_Click;

            this.Controls.Add(lblQuestion);
            this.Controls.Add(option1);
            this.Controls.Add(option2);
            this.Controls.Add(option3);
            this.Controls.Add(option4);
            this.Controls.Add(btnNext);
        }

        private void LoadQuestions()
        {
            questions.Add(new Question()
            {
                Text = "1. What do open palms usually communicate?",
                Options = new string[]
                {
                    "Aggression",
                    "Honesty and openness",
                    "Fear",
                    "Sadness"
                },
                CorrectAnswer = "Honesty and openness"
            });

            questions.Add(new Question()
            {
                Text = "2. What does crossed arms commonly indicate?",
                Options = new string[]
                {
                    "Confidence",
                    "Relaxation",
                    "Defensiveness",
                    "Excitement"
                },
                CorrectAnswer = "Defensiveness"
            });

            questions.Add(new Question()
            {
                Text = "3. What is mirroring?",
                Options = new string[]
                {
                    "Copying gestures",
                    "Ignoring gestures",
                    "Avoiding eye contact",
                    "Standing still"
                },
                CorrectAnswer = "Copying gestures"
            });

            questions.Add(new Question()
            {
                Text = "4. What does a head nod usually mean?",
                Options = new string[]
                {
                    "Disagreement",
                    "Agreement",
                    "Fear",
                    "Anxiety"
                },
                CorrectAnswer = "Agreement"
            });

            questions.Add(new Question()
            {
                Text = "5. What does a palm-down gesture communicate?",
                Options = new string[]
                {
                    "Submission",
                    "Authority",
                    "Fear",
                    "Excitement"
                },
                CorrectAnswer = "Authority"
            });

            // You can continue adding more questions here
        }

        private void ShowQuestion()
        {
            if (currentQuestion >= questions.Count)
            {
                MessageBox.Show(
                    $"Quiz Finished!\nYour Score: {score}/{questions.Count}",
                    "Results"
                );

                Application.Exit();
                return;
            }

            Question q = questions[currentQuestion];

            lblQuestion.Text = q.Text;

            option1.Text = q.Options[0];
            option2.Text = q.Options[1];
            option3.Text = q.Options[2];
            option4.Text = q.Options[3];

            option1.Checked = false;
            option2.Checked = false;
            option3.Checked = false;
            option4.Checked = false;
        }

        private void BtnNext_Click(object sender, EventArgs e)
        {
            string selectedAnswer = "";

            if (option1.Checked)
                selectedAnswer = option1.Text;

            else if (option2.Checked)
                selectedAnswer = option2.Text;

            else if (option3.Checked)
                selectedAnswer = option3.Text;

            else if (option4.Checked)
                selectedAnswer = option4.Text;

            if (selectedAnswer == questions[currentQuestion].CorrectAnswer)
            {
                score++;
            }

            currentQuestion++;

            ShowQuestion();
        }
    }

    public class Question
    {
        public string Text { get; set; }

        public string[] Options { get; set; }

        public string CorrectAnswer { get; set; }
    }
}
